{
  "name": "text-sanctifier",
  "version": "1.3.14",
  "type": "module",
  "description": "Find and remove invisible Unicode in web input, model-bound text and repositories.",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.js",
  "browser": "./dist/text-sanctifier.min.js",
  "bin": {
    "text-sanctifier": "bin/text-sanctifier.js"
  },
  "files": [
    "src",
    "bin",
    "dist/text-sanctifier.min.js",
    "dist/types",
    "LICENSE",
    "README.md",
    "ADDITIONAL_TERMS.md",
    "robots.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./hidden": {
      "types": "./dist/types/hiddenText.d.ts",
      "default": "./src/hiddenText.js"
    },
    "./context": {
      "types": "./dist/types/context.d.ts",
      "default": "./src/context.js"
    },
    "./browser": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/text-sanctifier.min.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "gen": "node scripts/gen-categories.js && node scripts/gen-version.js && node scripts/gen-virama.js && node scripts/gen-docs.js",
    "gen:check": "node scripts/gen-categories.js --check && node scripts/gen-version.js --check && node scripts/gen-virama.js --check && node scripts/gen-docs.js --check",
    "build": "node scripts/build.js",
    "build:types": "tsc -p tsconfig.types.json",
    "test:types": "node scripts/check-types.js",
    "test": "node tests/sanctifyText.test.js && node tests/inspectTextDetailed.test.js && node --expose-gc tests/hiddenText.test.js && node --expose-gc tests/context.test.js && node tests/cli.test.js && node tests/release.test.js && node tests/names.test.js && node tests/docs.test.js && node tests/repo.test.js",
    "test-min": "node tests/sanctifyText.test.min.js",
    "check:self": "node bin/text-sanctifier.js check .",
    "check:names": "node scripts/check-names.js",
    "check:repo": "node scripts/check-repo.js",
    "ci": "npm run gen:check && npm run check:names && npm run check:repo && npm run check:self && npm run test && npm run build && npm run size && npm run build:types && npm run test:types && npm run test-min",
    "size": "node scripts/check-size.js",
    "bench": "node --expose-gc scripts/bench.js",
    "release:prep": "node scripts/release.js prep",
    "release:verify": "node scripts/release.js verify",
    "prepublishOnly": "node scripts/release.js check-publish",
    "hooks:install": "git config core.hooksPath scripts/hooks"
  },
  "keywords": [
    "text",
    "sanitize",
    "normalize",
    "invisible",
    "scrubber",
    "unicode",
    "clean",
    "sanctify"
  ],
  "author": "WATT3D <WATT3D@protonmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWhatty/text-sanctifier.git"
  },
  "bugs": {
    "url": "https://github.com/iWhatty/text-sanctifier/issues"
  },
  "homepage": "https://github.com/iWhatty/text-sanctifier#readme",
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "typesVersions": {
    "*": {
      "hidden": [
        "dist/types/hiddenText.d.ts"
      ],
      "context": [
        "dist/types/context.d.ts"
      ],
      "browser": [
        "dist/types/index.d.ts"
      ]
    }
  }
}
